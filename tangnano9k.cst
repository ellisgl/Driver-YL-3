// Tang Nano 9K pin constraints

IO_LOC  "RCK" 70;
IO_PORT "RCK" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC  "SCK" 71;
IO_PORT "SCK" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC  "DIO" 72;
IO_PORT "DIO" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S1 button, active low
IO_LOC  "rst_n" 3;
IO_PORT "rst_n" IO_TYPE=LVCMOS18;
